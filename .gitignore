```gitignore
# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# =========================
# Environment / Secrets
# =========================
.env
.env.*
!.env.example

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# OS
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Logs
# =========================
*.log

# =========================
# Generated / Processed Data
# =========================
processed/chroma/
processed/pages/
processed/**/*.bin

# =========================
# Temporary files
# =========================
*.tmp
*.temp

# =========================
# Python test/cache
# =========================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# =========================
# Build
# =========================
build/
dist/
*.egg-info/
```
